{
  "canvas": {
    "width": 1080,
    "height": 2340,
    "background": "#0B0C10",
    "theme": "dark",
    "style": {
      "position": "relative",
      "overflow": "hidden",
      "fontFamily": "PingFang SC, system-ui, sans-serif"
    }
  },
  "layout": {
    "type": "absolute",
    "width": "100%",
    "height": "100%",
    "children": [
      {
        "id": "fullscreen-bg",
        "type": "Image",
        "position": 1,
        "styles": {
          "width": "100%",
          "height": "100%",
          "objectFit": "cover",
          "zIndex": 1
        }
      },
      {
        "id": "top-action-layer",
        "type": "Header",
        "position": 2,
        "styles": {
          "position": "absolute",
          "top": "60px",
          "left": "0px",
          "width": "100%",
          "display": "flex",
          "flexDirection": "row",
          "justifyContent": "space-between",
          "alignItems": "flex-start",
          "padding": "0px 54px",
          "zIndex": 10
        }
      },
      {
        "id": "interactive-chat-layer",
        "type": "Section",
        "position": 3,
        "styles": {
          "position": "absolute",
          "bottom": "0px",
          "left": "0px",
          "width": "100%",
          "display": "flex",
          "flexDirection": "column",
          "justifyContent": "flex-end",
          "padding": "0px 54px 40px 54px",
          "gap": "32px",
          "zIndex": 10
        }
      }
    ]
  },
  "components": [
    {
      "id": "settings-button",
      "parentId": "top-action-layer",
      "type": "Button",
      "styles": {
        "width": "64px",
        "height": "64px",
        "background": "transparent",
        "display": "flex",
        "justifyContent": "center",
        "alignItems": "center"
      },
      "children": [
        {
          "id": "settings-icon",
          "type": "Icon",
          "content": "gear",
          "styles": {
            "width": "48px",
            "height": "48px",
            "color": "rgba(255, 255, 255, 0.8)"
          }
        }
      ]
    },
    {
      "id": "pip-avatar-window",
      "parentId": "top-action-layer",
      "type": "Card",
      "styles": {
        "width": "260px",
        "height": "260px",
        "borderRadius": "40px",
        "background": "rgba(255, 255, 255, 0.15)",
        "backdropFilter": "blur(30px)",
        "border": "2px solid rgba(255, 255, 255, 0.4)",
        "boxShadow": "0px 16px 40px rgba(0, 0, 0, 0.3)",
        "overflow": "hidden",
        "display": "flex",
        "justifyContent": "center",
        "alignItems": "center"
      },
      "children": [
        {
          "id": "pip-character-image",
          "type": "Image",
          "styles": {
            "width": "92%",
            "height": "92%",
            "borderRadius": "32px",
            "objectFit": "cover"
          }
        }
      ]
    },
    {
      "id": "dialogue-bubble",
      "parentId": "interactive-chat-layer",
      "type": "Div",
      "styles": {
        "alignSelf": "flex-start",
        "maxWidth": "85%",
        "background": "linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.1) 100%)",
        "backdropFilter": "blur(40px)",
        "border": "1px solid rgba(255, 255, 255, 0.3)",
        "borderRadius": "40px",
        "padding": "36px 48px",
        "boxShadow": "0px 12px 32px rgba(0, 0, 0, 0.15)",
        "position": "relative"
      },
      "children": [
        {
          "id": "dialogue-text",
          "type": "Text",
          "content": "你好啊，我是你今天的导游",
          "styles": {
            "fontSize": "42px",
            "fontWeight": "500",
            "color": "#FFFFFF",
            "lineHeight": "60px",
            "letterSpacing": "1px"
          }
        }
      ]
    },
    {
      "id": "quick-questions-group",
      "parentId": "interactive-chat-layer",
      "type": "Div",
      "styles": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "20px",
        "width": "60%"
      },
      "children": [
        {
          "id": "quick-q-1",
          "type": "Button",
          "content": "快捷问题一",
          "styles": {
            "width": "100%",
            "height": "96px",
            "background": "rgba(255, 255, 255, 0.12)",
            "backdropFilter": "blur(20px)",
            "border": "1px solid rgba(255, 255, 255, 0.2)",
            "borderRadius": "48px",
            "padding": "0px 40px",
            "fontSize": "34px",
            "color": "rgba(255, 255, 255, 0.9)",
            "textAlign": "left"
          }
        },
        {
          "id": "quick-q-2",
          "type": "Button",
          "content": "快捷问题二",
          "styles": {
            "width": "100%",
            "height": "96px",
            "background": "rgba(255, 255, 255, 0.12)",
            "backdropFilter": "blur(20px)",
            "border": "1px solid rgba(255, 255, 255, 0.2)",
            "borderRadius": "48px",
            "padding": "0px 40px",
            "fontSize": "34px",
            "color": "rgba(255, 255, 255, 0.9)",
            "textAlign": "left"
          }
        },
        {
          "id": "quick-q-3",
          "type": "Button",
          "content": "快捷问题三",
          "styles": {
            "width": "100%",
            "height": "96px",
            "background": "rgba(255, 255, 255, 0.12)",
            "backdropFilter": "blur(20px)",
            "border": "1px solid rgba(255, 255, 255, 0.2)",
            "borderRadius": "48px",
            "padding": "0px 40px",
            "fontSize": "34px",
            "color": "rgba(255, 255, 255, 0.9)",
            "textAlign": "left"
          }
        }
      ]
    },
    {
      "id": "bottom-input-bar",
      "parentId": "interactive-chat-layer",
      "type": "Div",
      "styles": {
        "width": "100%",
        "height": "160px",
        "background": "linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.08) 100%)",
        "backdropFilter": "blur(40px)",
        "border": "2px solid rgba(255, 255, 255, 0.25)",
        "borderRadius": "80px",
        "padding": "0px 32px 0px 56px",
        "display": "flex",
        "flexDirection": "row",
        "justifyContent": "space-between",
        "alignItems": "center",
        "boxShadow": "0px 20px 48px rgba(0, 0, 0, 0.2)",
        "marginTop": "16px"
      },
      "children": [
        {
          "id": "text-input-field",
          "type": "Input",
          "styles": {
            "flex": "1",
            "background": "transparent",
            "border": "none",
            "fontSize": "38px",
            "color": "#FFFFFF",
            "placeholderColor": "rgba(255, 255, 255, 0.45)"
          }
        },
        {
          "id": "action-buttons-group",
          "type": "Div",
          "styles": {
            "display": "flex",
            "flexDirection": "row",
            "alignItems": "center",
            "gap": "24px"
          },
          "children": [
            {
              "id": "plus-action-btn",
              "type": "Button",
              "styles": {
                "width": "96px",
                "height": "96px",
                "borderRadius": "50%",
                "background": "rgba(255, 255, 255, 0.2)",
                "display": "flex",
                "justifyContent": "center",
                "alignItems": "center"
              },
              "children": [
                {
                  "id": "plus-icon",
                  "type": "Icon",
                  "content": "plus",
                  "styles": {
                    "width": "44px",
                    "height": "44px",
                    "color": "#FFFFFF"
                  }
                }
              ]
            },
            {
              "id": "send-message-btn",
              "type": "Button",
              "styles": {
                "width": "112px",
                "height": "112px",
                "borderRadius": "50%",
                "background": "linear-gradient(135deg, #5B92FF 0%, #3867ED 100%)",
                "display": "flex",
                "justifyContent": "center",
                "alignItems": "center",
                "boxShadow": "0px 8px 20px rgba(56, 103, 237, 0.4)"
              },
              "children": [
                {
                  "id": "send-icon",
                  "type": "Icon",
                  "content": "paper-plane",
                  "styles": {
                    "width": "48px",
                    "height": "48px",
                    "color": "#FFFFFF"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "system-home-indicator",
      "parentId": "interactive-chat-layer",
      "type": "Div",
      "styles": {
        "width": "380px",
        "height": "10px",
        "background": "#FFFFFF",
        "borderRadius": "5px",
        "alignSelf": "center",
        "marginTop": "24px",
        "opacity": "0.9"
      }
    }
  ],
  "assets": {
    "colors": {
      "glassBackground": "rgba(255, 255, 255, 0.15)",
      "glassBorder": "rgba(255, 255, 255, 0.25)",
      "primaryAccent": "linear-gradient(135deg, #5B92FF, #3867ED)",
      "textMain": "#FFFFFF",
      "textMuted": "rgba(255, 255, 255, 0.45)"
    },
    "spacing": {
      "horizontalMargin": "54px",
      "itemGapVertical": "20px",
      "layerGapVertical": "32px"
    },
    "borderRadius": {
      "pill": "80px",
      "bubble": "40px",
      "pip": "40px"
    }
  }
}

